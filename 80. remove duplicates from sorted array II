class Solution {
    public int removeDuplicates(int[] nums) {
        if(nums.length==0)
            return 0;
        HashMap<Integer,Integer> count=new HashMap<>();
        count.put(nums[0],1);
        int place=1;
        for(int i=1;i<nums.length;i++)
        {
            if(count.containsKey(nums[i]))
            {
                if(count.get(nums[i])==1)
                {
                    nums[place++]=nums[i];
                    count.put(nums[i],2);
                }
            }
            else
            {
                count.put(nums[i],1);
                nums[place++]=nums[i];
            }
        }
        return place;
    }
}
