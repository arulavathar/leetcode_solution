class Solution {
    public int maxProfit(int[] prices) {
        int profit=0;
        int minprice=Integer.MAX_VALUE;
        for(int i: prices)
        {
            if(minprice>i)
                minprice=i;
            int sellingprice=i-minprice;
            if(sellingprice>profit)
                profit=sellingprice;
        }
        return profit;
    }
}
